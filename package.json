{
  "name": "daylens",
  "version": "1.1.0",
  "description": "Know where your day actually goes",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "author": {
    "name": "DayLens",
    "email": "hello@daylens.app"
  },
  "license": "MIT",
  "build": {
    "appId": "app.daylens.desktop",
    "productName": "DayLens",
    "copyright": "Copyright \u00a9 2025 DayLens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DayLens",
      "include": "assets/installer.nsh",
      "runAfterFinish": true,
      "perMachine": false,
      "menuCategory": "DayLens"
    },
    "portable": {
      "artifactName": "DayLens-Portable-${version}.exe"
    },
    "publish": null
  }
}